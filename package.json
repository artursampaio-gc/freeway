{
  "name": "freeway",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "esbuild web/app.ts --bundle --minify --format=esm --target=es2020 --outfile=dist/app.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/run.ts --bundle --platform=node --format=esm --outfile=dist/test.mjs && node dist/test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "htm": "^3.1.1",
    "preact": "^10.25.0",
    "typescript": "^5.7.0"
  }
}
